<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_salat_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title"
                    android:textColor="@color/pulse_green"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/PulseBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_status"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_prayer"
                android:textColor="@color/pulse_green_tint"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/next_prayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/not_configured"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/PulseCard">
            <TextView
                style="@style/PulseHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_heading" />
            <TextView
                style="@style/PulseBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/location_help" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/city"
                android:textColor="@color/pulse_muted"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/city"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/city_example"
                android:inputType="textCapWords"
                android:importantForAutofill="no" />
            <Button
                android:id="@+id/find_city"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/find_city" />
            <Button
                android:id="@+id/use_location"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_location" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/latitude" android:textStyle="bold" />
                    <EditText android:id="@+id/latitude" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/latitude_example" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/longitude" android:textStyle="bold" />
                    <EditText android:id="@+id/longitude" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/longitude_example" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/timezone"
                android:textColor="@color/pulse_muted"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/timezone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/timezone_example"
                android:inputType="text"
                android:importantForAutofill="no" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/calculation_method" android:textStyle="bold" />
            <Spinner android:id="@+id/calculation_method" android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/asr_method" android:textStyle="bold" />
            <Spinner android:id="@+id/asr_method" android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/high_latitude" android:textStyle="bold" />
            <Spinner android:id="@+id/high_latitude" android:layout_width="match_parent" android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout style="@style/PulseCard">
            <TextView style="@style/PulseHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alerts_heading" />
            <TextView style="@style/PulseBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alerts_help" />
            <LinearLayout
                android:id="@+id/prayer_alerts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView style="@style/PulseHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/adhan_audio" />
            <TextView
                android:id="@+id/adhan_file"
                style="@style/PulseBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_adhan_selected" />
            <Button
                android:id="@+id/select_adhan"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_adhan" />
        </LinearLayout>

        <LinearLayout style="@style/PulseCard">
            <TextView style="@style/PulseHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permissions_heading" />
            <TextView
                android:id="@+id/alert_status"
                style="@style/PulseBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/allow_notifications"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_notifications" />
            <Button
                android:id="@+id/allow_exact_alarms"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_exact_alarms" />
            <Button
                android:id="@+id/save_alerts"
                style="@style/PulseButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_alerts" />
            <Button
                android:id="@+id/test_alert"
                style="@style/PulseButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_alert" />
        </LinearLayout>

        <LinearLayout style="@style/PulseCard">
            <TextView style="@style/PulseHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/today_heading" />
            <LinearLayout
                android:id="@+id/today_times_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                style="@style/PulseBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/offline_note" />
        </LinearLayout>

        <TextView
            style="@style/PulseBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/credits" />
    </LinearLayout>
</ScrollView>
