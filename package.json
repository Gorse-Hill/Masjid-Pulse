{
  "name": "masjid-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Masjid Pulse - free mosque prayer-time TV display system (MVP)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node scripts/build-tv.mjs",
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "npm run build:web && tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "bash scripts/smoke.sh",
    "start:env": "node --env-file=.env dist/server.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "acorn": "^8.19.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "core-js": "^3.50.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "whatwg-fetch": "^3.6.20"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.4.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "zod": "^4.6.5"
  }
}
