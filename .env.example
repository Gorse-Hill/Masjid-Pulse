# Masjid Pulse configuration. Copy to .env (git-ignored) and fill in, then: npm run start:env
# NEVER commit real secrets. .env is listed in .gitignore.

NODE_ENV=production
PORT=3000
# Public URL used in email links (verification, password reset, invitations)
APP_URL=https://pulse.example.org
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_FILE=data/masjid-pulse.db
UPLOAD_DIR=data/uploads
# Set to 1 (or the number of proxy hops) when running behind a reverse proxy, so per-IP rate limits
# use the real client IP. Leave empty when clients connect directly.
TRUST_PROXY=
# 1 = redirect plain HTTP to HTTPS (behind a TLS proxy, with TRUST_PROXY) except the TV display paths,
# so old Smart TVs that reject modern certificate roots can still open http://host/tv/.
HTTPS_REDIRECT=

# --- Email (SMTP). Read ONLY from the environment; never written to disk by the app. ---
# Intended setup: Gmail SMTP with an App Password (Google Account > Security > 2-Step Verification >
# App passwords). Port 465 = implicit TLS. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ahmed.gorse@gmail.com
SMTP_PASS=
MAIL_FROM=Masjid Pulse <ahmed.gorse@gmail.com>

# Development only: with no SMTP_HOST and NODE_ENV != production, DEV_OUTBOX=1 exposes
# GET /api/dev/outbox (used by scripts/smoke.sh). Never enable in production.
DEV_OUTBOX=
